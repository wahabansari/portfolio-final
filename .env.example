# Copy to .env.local for development, or set these in the Vercel project's
# Environment Variables for production. Nothing here is required to build or
# run the site — every one of these has a safe fallback — but leaving them
# unset means the corresponding feature is silently off.

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Unset: the site ships zero analytics JavaScript — this is why an SEO audit
# tool will report "no analytics tool detected" even though the tracking
# code (see src/components/gtm.tsx, src/components/analytics.tsx) is already
# built and wired to every CTA via data-track attributes. Create a GTM
# container at tagmanager.google.com, add a GA4 configuration tag inside it,
# and set the container ID here to turn measurement on — no code change
# needed.
NEXT_PUBLIC_GTM_ID=

# Resend API key for the contact form (resend.com). Unset: the contact
# endpoint returns 501 and the form falls back to a mailto: link instead of
# failing silently.
RESEND_API_KEY=

# Sender/recipient overrides for contact-form email. Optional — fall back to
# Resend's shared sender and site.email respectively.
CONTACT_FROM=
CONTACT_TO=
